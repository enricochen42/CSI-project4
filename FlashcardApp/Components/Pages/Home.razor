@page "/"

<PageTitle>Home - StudyCards</PageTitle>

<div class="hero-section fade-in-up">
    <div class="hero-content">
        <h1 class="hero-title">
            Turn your lecture slides into <span class="gradient-text">study flashcards</span>
        </h1>
        <p class="hero-subtitle">
            Upload your slides and let AI help you create flashcards for studying and exam prep
        </p>
        <div class="hero-actions">
            <a href="/upload" class="btn btn-primary btn-large">Get Started</a>
            <a href="/study" class="btn btn-secondary btn-large">Start Studying</a>
        </div>
    </div>
</div>

<style>
    .hero-section {
        text-align: center;
        padding: 4rem 0 6rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .hero-title {
        font-size: clamp(2.5rem, 5vw, 4rem);
        font-weight: 400;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        color: #4a4a4a;
    }

    .hero-subtitle {
        font-size: 1.375rem;
        color: #5a5a5a;
        margin-bottom: 2.5rem;
        line-height: 1.7;
        max-width: 650px;
        margin-left: auto;
        margin-right: auto;
        font-weight: 300;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-large {
        padding: 1rem 2.5rem;
        font-size: 1.1rem;
    }

    @@media (max-width: 768px) {
        .hero-section {
            padding: 2rem 0 4rem;
        }

        .hero-actions {
            flex-direction: column;
        }

        .btn-large {
            width: 100%;
        }
    }
</style>
